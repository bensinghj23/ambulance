rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Intersections — Read by anyone, written by backend/admin
    match /intersections/{intersectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ambulances — Read by anyone, updated by system/driver
    match /ambulances/{ambulanceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Traffic State & Signal States — Read by all, written by controller/CV backend
    match /trafficState/{intersectionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /signalStates/{intersectionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Emergency Events & Simulation Runs
    match /emergencyEvents/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /simulationRuns/{runId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    // System Config
    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
